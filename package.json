{
  "name": "protoboard",
  "version": "0.1.0",
  "description": "A declarative HTML/Web Component library for rapid prototyping of tabletop and board games in the browser.",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/types/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "rollup -c",
    "test": "playwright test",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,html}\""
  },
  "keywords": [
    "boardgame",
    "tabletop",
    "web-components",
    "lit",
    "custom-elements"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "grapevine": "^0.2.0",
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.42.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "rollup": "^4.13.0",
    "typescript": "^5.4.0"
  }
}
