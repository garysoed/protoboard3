{
  "name": "protoboard",
  "version": "0.1.0",
  "description": "A declarative HTML/Web Component library for rapid prototyping of tabletop and board games in the browser.",
  "type": "module",
  "main": "dist/index.mjs",
  "module": "dist/index.mjs",
  "types": "dist/types/src/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "npm run build:styles && rollup -c",
    "build:site": "npm run build:styles && rollup -c",
    "build:styles": "sass site/styles.scss site/dist/styles.css --load-path=node_modules --style=compressed --no-source-map",
    "format": "prettier --write \"**/*.{ts,js,mjs,json,md,html}\"",
    "lint": "eslint . --ext .ts",
    "start": "npx serve site",
    "test": "npm run build && playwright test",
    "test:debug": "npm run build && playwright test --ui",
    "test:e2e": "npm run build && playwright test --project=e2e-chromium --project=e2e-firefox --project=e2e-webkit",
    "test:unit": "npm run build && playwright test --project=unit"
  },
  "keywords": [
    "boardgame",
    "tabletop",
    "web-components",
    "lit",
    "custom-elements"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@lit-labs/signals": "^0.3.0",
    "@lit/context": "^1.1.6",
    "gs-tools": "*",
    "lit": "^3.1.2"
  },
  "devDependencies": {
    "@carbon/styles": "^1.58.0",
    "@carbon/web-components": "^2.19.0",
    "@playwright/test": "^1.42.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^7.0.2",
    "@typescript-eslint/parser": "^7.0.2",
    "devbase": "*",
    "eslint": "^8.57.0",
    "eslint-plugin-import": "^2.29.1",
    "eslint-plugin-perfectionist": "^4.2.0",
    "eslint-plugin-tsdoc": "^0.2.17",
    "prettier": "^3.2.5",
    "rollup": "^4.13.0",
    "sass": "^1.79.4",
    "typescript": "^5.4.0"
  }
}
